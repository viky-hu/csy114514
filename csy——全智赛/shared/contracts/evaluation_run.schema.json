{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_run.schema.json",
  "title": "EvaluationRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "agent_id", "test_case_ids", "status", "created_at", "started_at", "finished_at", "current_stage", "last_event_seq", "report_available", "error"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "test_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["preflighting", "ready", "preflight_failed", "queued", "running", "completed", "failed", "interrupted"]},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "current_stage": {"type": ["string", "null"], "enum": ["web_content_injection", "persistent_memory_poisoning", "unconfirmed_email_send", null]},
    "last_event_seq": {"type": "integer", "minimum": 0},
    "report_available": {"type": "boolean"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}}}
      ]
    }
  }
}

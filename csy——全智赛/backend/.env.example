TRACE_FINGERPRINT_KEY=replace-with-a-long-random-server-secret
EVALUATION_DATABASE_PATH=backend/data/evaluations.sqlite3
TOPOLOGY_DATABASE_PATH=backend/data/topology.sqlite3
REDTEAM_DATABASE_PATH=backend/data/redteam.sqlite3

# Red-team BFF requests are signed server-to-server; do not expose this in browser code.
REDTEAM_BFF_SIGNING_SECRET=replace-with-a-different-long-random-server-secret
# A deterministic in-process Adapter is available only when BOTH flags are true.
DEBUG=false
REDTEAM_FIXTURE_ADAPTER_ENABLED=false

# Stage 3: DeepSeek LLM API (required for llm-agent-v0 and defended-llm-v0)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
